{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "BusinessCentral": {
    "Resilience": {
      "ThrottledBaseDelaySeconds": 5,
      "ThrottledMaxDelaySeconds": 60,
      "ThrottledMaxRetries": 5,
      "UnavailableBaseDelaySeconds": 30,
      "UnavailableMaxDelaySeconds": 120,
      "UnavailableMaxRetries": 4,
      "CircuitMinimumThroughput": 3,
      "CircuitFailurePercentageThreshold": 50,
      "CircuitSamplingWindowSeconds": 60,
      "CircuitBreakDurationSeconds": 10,
      "CircuitHalfOpenProbeCount": 1
    }
  }
}
