<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>DynamicsBcDemo.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\DynamicsBcDemo\DynamicsBcDemo.Contracts\DynamicsBcDemo.Contracts.csproj" />
    <ProjectReference Include="..\..\samples\DynamicsBcDemo\BusinessCentral.Api\BusinessCentral.Api.csproj" />
    <ProjectReference Include="..\..\samples\DynamicsBcDemo\BusinessCentral.Adapter\BusinessCentral.Adapter.csproj" />
    <ProjectReference Include="..\..\samples\DynamicsBcDemo\D365Sales.Api\D365Sales.Api.csproj" />
    <!-- Other catalogs that may share a Service Bus namespace with this sample: EventTypeIds are
         global to a namespace, so the tests check that none collide. -->
    <ProjectReference Include="..\..\samples\CrmErpDemo\CrmErpDemo.Contracts\CrmErpDemo.Contracts.csproj" />
    <ProjectReference Include="..\..\src\NimBus\NimBus.csproj" />
  </ItemGroup>

</Project>
