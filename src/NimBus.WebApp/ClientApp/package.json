{
  "name": "nimbus-management-clientapp",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "buildpro": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --reporter=junit --outputFile=test-results.xml",
    "clean": "rimraf build",
    "fmt": "prettier --write ./src",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "gen-postman": "npx --yes --package openapi-to-postmanv2@6.3.3 -- openapi2postmanv2 -s ../api-spec.yaml -o ../api.postman_collection.json -p"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@microsoft/signalr": "^8.0.0",
    "@tanstack/react-table": "^8.11.0",
    "clsx": "^2.1.0",
    "js-cookie": "^3.0.5",
    "moment": "^2.30.1",
    "react": "^19.2.8",
    "react-d3-tree": "^3.6.2",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.7.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.13",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.10",
    "vite-plugin-compression2": "2.5.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "uuid": "^14.0.0"
  }
}
