{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Crm": {
    "CircuitBreaker": {
      "MinimumThroughput": 5,
      "FailurePercentageThreshold": 50,
      "SamplingWindowSeconds": 60,
      "BreakDurationSeconds": 20,
      "HalfOpenProbeCount": 2
    }
  }
}
